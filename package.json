{
  "name": "qatar-air-defense",
  "version": "1.0.0",
  "description": "Qatar Air Defense Command — radar-based air defense game",
  "main": "electron-main.js",
  "scripts": {
    "start":  "electron .",
    "web":    "python -m http.server 8000",
    "dev":    "webpack serve --mode development",
    "build":  "webpack --mode production",
    "package": "electron-builder --win",
    "package:dir": "electron-builder --win --dir"
  },
  "type": "module",
  "keywords": [
    "game",
    "radar",
    "air-defense",
    "strategy"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "copy-webpack-plugin": "^14.0.0",
    "electron": "^37.2.6",
    "electron-builder": "^25.1.8",
    "html-webpack-plugin": "^5.6.6",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.3"
  },
  "build": {
    "appId": "com.qatarairdefense.desktop",
    "productName": "Qatar Air Defense Command",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "electron-main.js",
      "electron-preload.cjs",
      "src/**/*",
      "styles/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
